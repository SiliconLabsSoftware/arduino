project_name: zigbee_arduino_gsdk_config_thingplusmatter
package: Zigbee
label: Arduino Zigbee and GSDK config for the SparkFun Thing Plus Matter
description: >
  Arduino Zigbee and GSDK config for the SparkFun Thing Plus Matter (brd2704a)
quality: production

component:
  # System
  - id: sl_system
  - id: device_init
  - id: device_init_nvic
  - id: clock_manager

  # Zigbee stack (Router)
  - id: zigbee_pro_stack
  - id: zigbee_source_route
  - id: zigbee_gp
  - id: zigbee_zcl_framework_core

  # ZCL clusters
  - id: zigbee_basic
  - id: zigbee_identify
  - id: zigbee_groups_server
  - id: zigbee_on_off
  - id: zigbee_level_control
  - id: zigbee_color_control_server
  - id: zigbee_scenes
  - id: zigbee_reporting
  - id: zigbee_counters
  - id: zigbee_ias_zone_server

  # ZLL
  - id: zigbee_zll
  - id: zigbee_zll_commissioning_common
  - id: zigbee_zll_commissioning_server
  - id: zigbee_zll_on_off_server
  - id: zigbee_zll_level_control_server
  - id: zigbee_zll_identify_server
  - id: zigbee_zll_scenes_server
  - id: zigbee_zll_utility_server
  - id: zigbee_interpan

  # Zigbee 3.0 networking
  - id: zigbee_network_creator
  - id: zigbee_network_creator_security
  - id: zigbee_network_steering
  - id: zigbee_find_and_bind_target
  - id: zigbee_scan_dispatch
  - id: zigbee_update_tc_link_key

  # Green Power
  - id: zigbee_green_power_common
  - id: zigbee_green_power_client

  # RTOS
  - id: zigbee_ipc
  - id: freertos

  # Radio
  - id: rail_util_pti

  # Arduino platform components
  - id: psa_crypto
  - id: power_manager
  - id: bootloader_interface
  - id: app_assert
  - id: component_catalog
  - id: mpu
  - id: udelay
  - id: app_log
  - id: iostream_usart
    instance:
     - vcom
  - id: iostream_eusart
    instance:
    - thingplus1
  - id: i2cspm
    instance:
     - qwiic
  - id: spidrv_eusart
    instance:
     - thingplus
     - thingplus1
  - id: emlib_iadc
  - id: pwm
    instance:
    - led0
  - id: emlib_vdac
  - id: gpiointerrupt
  - id: emlib_rmu
  - id: emlib_wdog
  - id: nvm3_default
  - id: nvm3_default_config
  - id: nvm3_default_flash_backend
  - id: nvm3_lib
  - id: memory_manager_cpp

requires:
  - name: brd2704a

source:
  - path: main.c
  - path: app.c

include:
  - path: .

config_file:
  - path: config/zcl/zcl_config.zap
    file_id: zap_configuration_file_id
    directory: zcl
  - path: sl_spidrv_eusart_thingplus1_config.h
    override:
      component: spidrv_eusart
      instance: thingplus1
      file_id: spidrv_eusart_config
  - path: sl_iostream_eusart_thingplus1_config.h
    override:
      component: iostream_eusart
      instance: thingplus1
      file_id: iostream_eusart_config

define:
  - name: NVM3_DEFAULT_NVM_SIZE
    value: "32768"

configuration:
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_DEVICE_TYPE
    value: SLI_ZIGBEE_NETWORK_DEVICE_TYPE_ROUTER
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_SECURITY_TYPE
    value: SLI_ZIGBEE_NETWORK_SECURITY_TYPE_3_0
  - name: SL_ZIGBEE_BINDING_TABLE_SIZE
    value: 10
  - name: SL_ZIGBEE_AF_PLUGIN_NETWORK_STEERING_SCAN_DURATION
    value: 3
  - name: SL_ZIGBEE_AF_PLUGIN_NETWORK_STEERING_TRY_ALL_KEYS
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_IAS_ZONE_SERVER_ZONE_TYPE
    value: SL_ZIGBEE_ZCL_IAS_ZONE_TYPE_CONTACT_SWITCH
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_SPIDRV_EUSART_THINGPLUS_CS_CONTROL
    value: "spidrvCsControlApplication"
  - name: SL_SPIDRV_EUSART_THINGPLUS1_CS_CONTROL
    value: "spidrvCsControlApplication"
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: SL_STACK_SIZE
    value: 1024
  - name: configTIMER_TASK_PRIORITY
    value: 53

tag:
  - hardware:rf:band:2400
